import SparseHamiltonian.HamiltonianStability

/-!
# Simulation from general uniform block-encoding programs

Every source lookup program is compiled to a full-space Hermitian involution
with at most four times its query count. The weighted clock simulation then
constructs an actual ordinary-lookup circuit for the weighted Hermitian parts
of the source blocks. No source involution or selected-query implementation
is assumed. The maximum and average clock budgets are derived from explicit
source query allowances.
-/

namespace SparseHamiltonian.GeneralLookupSimulation

noncomputable section
open ContinuousLinearMap OracleCircuit MaskedLookupCurry HermitianLookupProgram
open scoped BigOperators InnerProduct
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000
set_option synthInstance.maxSize 512

variable {X I A Z : Type*} [Fintype I] [Fintype A] [Fintype Z] [AddCommGroup Z]
variable {P : Type*} [NormedAddCommGroup P] [InnerProductSpace ℂ P] [CompleteSpace P]

/-- Exact Hermitian-involution programs over one common expanded-address lookup. -/
def programs (f : X → A → Z) (ps : I → Program (localSigned 1 f)) :
    I → Program (localSigned 1 (expandedTable f)) :=
  fun i => expandedProgram f (ps i)

/-- The actual average clock length uses counts of the constructed programs. -/
def averageLength (f : X → A → Z) (weights : I → ℝ)
    (ps : I → Program (localSigned 1 f)) : ℝ :=
  WeightedProgramClockBounds.averageLength weights (programs f ps)

/-- Fixed branch embeddings into the expanded payload, including the plus state. -/
def embeddings (E : I → P →ₗᵢ[ℂ] Payload A Z) :
    I → P →ₗᵢ[ℂ] Payload (Bool × A) Z := fun i => expandedEmbedding (E i)

/-- The target generated by arbitrary source block encodings is the weighted
sum of the Hermitian parts of their compressed outputs. -/
def generator (f : X → A → Z) (weights : I → ℝ)
    (ps : I → Program (localSigned 1 f)) (E : I → P →ₗᵢ[ℂ] Payload A Z) (x : X) :
    P →L[ℂ] P :=
  ∑ i, (weights i : ℂ) • HermitianDilation.hermitianPart
    ((E i).toContinuousLinearMap† ∘L (ps i).eval x ∘L (E i).toContinuousLinearMap)

omit [Fintype I] in
/-- Each constructed branch is an involution on the full physical payload. -/
theorem programs_involution (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (i : I) (x : X) (v : Payload (Bool × A) Z) :
    (programs f ps i).eval x ((programs f ps i).eval x v) = v :=
  expandedProgram_involution f (ps i) x v

omit [Fintype I] in
/-- Source query allowances give explicit maximum compiled clock lengths. -/
theorem slots_le (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (q : I → ℕ) (hq : ∀ i, (ps i).count ≤ q i) (i : I) :
    QueryClockStep.slots (programs f ps i) ≤ 4 * q i + 2 := by
  have h := (expandedProgram_count f (ps i)).trans (Nat.mul_le_mul_left 4 (hq i))
  simpa only [QueryClockStep.slots, programs] using Nat.add_le_add_right h 2

/-- Normalized weights give an average budget controlled by the weighted mean
source query count, rather than the maximum source count. -/
theorem averageLength_le (f : X → A → Z) (weights : I → ℝ)
    (ps : I → Program (localSigned 1 f)) (q : I → ℕ)
    (hw : ∀ i, 0 ≤ weights i) (hsum : ∑ i, weights i = 1)
    (hq : ∀ i, (ps i).count ≤ q i) :
    averageLength f weights ps ≤ 2 + 4 * ∑ i, weights i * (q i : ℝ) := by
  unfold averageLength
  rw [WeightedProgramClockBounds.averageLength_eq_meanQueries_add_two _ _ hsum]
  have hCounts : ∑ i, weights i * ((programs f ps i).count : ℝ) ≤
      4 * ∑ i, weights i * (q i : ℝ) := by
    calc
      ∑ i, weights i * ((programs f ps i).count : ℝ) ≤
          ∑ i, weights i * (4 * (q i : ℝ)) := by
        apply Finset.sum_le_sum
        intro i _
        apply mul_le_mul_of_nonneg_left _ (hw i)
        exact_mod_cast (expandedProgram_count f (ps i)).trans (Nat.mul_le_mul_left 4 (hq i))
      _ = 4 * ∑ i, weights i * (q i : ℝ) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        ring
  linarith

/-- The actual clock generator equals the stated weighted Hermitian source block. -/
theorem generator_eq (f : X → A → Z) (weights : I → ℝ)
    (ps : I → Program (localSigned 1 f)) (E : I → P →ₗᵢ[ℂ] Payload A Z) (x : X) :
    WeightedProgramClockBounds.generator weights (programs f ps) (embeddings E) x =
      generator f weights ps E x := by
  rw [WeightedProgramClockBounds.generator_eq_sum]
  unfold generator programs embeddings
  apply Finset.sum_congr rfl
  intro i _
  rw [expandedProgram_compression]

/-- The complete physical workspace of the expanded family. -/
abbrev Space (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (τ Q qbar ε : ℝ) :=
  ClockQuery.EvolutionSpace (P := Payload (Bool × A) Z)
    (V := PiLp 2 (fun _ : HeterogeneousLookupClock.Slot (expandedTable f) (programs f ps) =>
      Payload (Bool × A) Z)) τ Q qbar ε

/-- The common ordinary lookup acting on that explicit physical workspace. -/
def simulationOracle (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (τ Q qbar ε : ℝ) (x : X) : Space f ps τ Q qbar ε →L[ℂ] Space f ps τ Q qbar ε :=
  EncodedLookupClockSimulation.evolutionOracle
    (C := HeterogeneousLookupClock.Slot (expandedTable f) (programs f ps))
    (expandedTable f) τ Q qbar ε x

/-- Fixed input preparation for the constructed expanded-lookup simulation. -/
def input (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (e : P →ₗᵢ[ℂ] Payload A Z) (τ Q qbar ε : ℝ) :
    P →L[ℂ] Space f ps τ Q qbar ε :=
  WeightedLookupSimulation.input (expandedTable f) (programs f ps) (expandedEmbedding e)
    τ Q qbar ε

/-- Fixed full-output preparation for the same physical simulation circuit. -/
def output (f : X → A → Z) (ps : I → Program (localSigned 1 f))
    (e : P →ₗᵢ[ℂ] Payload A Z) (τ Q qbar ε : ℝ) :
    P →L[ℂ] Space f ps τ Q qbar ε :=
  WeightedLookupSimulation.output (expandedTable f) (programs f ps) (expandedEmbedding e)
    τ Q qbar ε

/-- General source lookup programs give an actual full-output simulator. The
query bound uses their actual compiled average; the displayed source allowance
bounds that average and suffices to bound every individual compiled clock. -/
theorem evolution_query_certificate [FiniteDimensional ℂ P]
    (f : X → A → Z) (weights : I → ℝ) (ps : I → Program (localSigned 1 f))
    (q : I → ℕ) (hq : ∀ i, (ps i).count ≤ q i)
    (hw : ∀ i, 0 ≤ weights i) (hsum : ∑ i, weights i = 1)
    (Q : ℝ) (hQ : 1 ≤ Q) (hqQ : ∀ i, 4 * (q i : ℝ) + 2 ≤ Q)
    (E : I → P →ₗᵢ[ℂ] Payload A Z) (e : P →ₗᵢ[ℂ] Payload A Z)
    (τ ε : ℝ) (hτ : 0 ≤ τ) (hε : 0 < ε) (hεOne : ε ≤ 1) :
    let qbar := averageLength f weights ps
    ∃ c : Program (K := Space f ps τ Q qbar ε) (simulationOracle f ps τ Q qbar ε),
      c.count ≤ 12 * FilterSchedule.degree Q (τ * qbar) (ε / 3) ∧
      (c.count : ℝ) ≤ 768 *
        (τ * qbar + Q * (1 + Real.log (3 * (Q + τ * qbar + 2) / ε))) ∧
      qbar ≤ 2 + 4 * (∑ i, weights i * (q i : ℝ)) ∧
      (input f ps e τ Q qbar ε)† ∘L input f ps e τ Q qbar ε = 1 ∧
      (output f ps e τ Q qbar ε)† ∘L output f ps e τ Q qbar ε = 1 ∧
      ∀ x : X, IsUnitary (c.eval x) ∧
        ‖c.eval x ∘L input f ps e τ Q qbar ε -
          output f ps e τ Q qbar ε ∘L
            NormedSpace.exp ((-Complex.I * (τ : ℂ)) • generator f weights ps E x)‖ ≤ ε := by
  have hSlots (i : I) : (QueryClockStep.slots (programs f ps i) : ℝ) ≤ Q := by
    have h := slots_le f ps q hq i
    have hReal : (QueryClockStep.slots (programs f ps i) : ℝ) ≤ 4 * (q i : ℝ) + 2 := by
      exact_mod_cast h
    exact hReal.trans (hqQ i)
  obtain ⟨c, hc, hReal, hIn, hOut, hError⟩ :=
    WeightedLookupSimulation.evolution_query_certificate (expandedTable f) weights (programs f ps)
      hw hsum Q hQ hSlots (programs_involution f ps) (embeddings E) (expandedEmbedding e)
      τ ε hτ hε hεOne
  refine ⟨c, hc, hReal, averageLength_le f weights ps q hw hsum hq, hIn, hOut, fun x => ?_⟩
  rw [← generator_eq f weights ps E x]
  exact hError x

/-- Errors in arbitrary source block encodings add with their nonnegative
weights. Hermitian dilation does not introduce an additional approximation loss. -/
theorem generator_error (f : X → A → Z) (weights : I → ℝ)
    (ps : I → Program (localSigned 1 f)) (E : I → P →ₗᵢ[ℂ] Payload A Z)
    (H : I → P →L[ℂ] P) (δ : I → ℝ) (hw : ∀ i, 0 ≤ weights i)
    (hH : ∀ i, (H i)† = H i) (x : X)
    (hError : ∀ i, ‖(E i).toContinuousLinearMap† ∘L (ps i).eval x ∘L
      (E i).toContinuousLinearMap - H i‖ ≤ δ i) :
    ‖generator f weights ps E x - ∑ i, (weights i : ℂ) • H i‖ ≤
      ∑ i, weights i * δ i := by
  have hDiff : generator f weights ps E x - ∑ i, (weights i : ℂ) • H i =
      ∑ i, (weights i : ℂ) •
        (HermitianDilation.hermitianPart ((E i).toContinuousLinearMap† ∘L
          (ps i).eval x ∘L (E i).toContinuousLinearMap) - H i) := by
    simp only [generator, smul_sub, Finset.sum_sub_distrib]
  rw [hDiff]
  calc
    ‖∑ i, (weights i : ℂ) •
        (HermitianDilation.hermitianPart ((E i).toContinuousLinearMap† ∘L
          (ps i).eval x ∘L (E i).toContinuousLinearMap) - H i)‖ ≤
        ∑ i, ‖(weights i : ℂ) •
          (HermitianDilation.hermitianPart ((E i).toContinuousLinearMap† ∘L
            (ps i).eval x ∘L (E i).toContinuousLinearMap) - H i)‖ := norm_sum_le _ _
    _ ≤ ∑ i, weights i * δ i := by
      apply Finset.sum_le_sum
      intro i _
      rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw i)]
      exact mul_le_mul_of_nonneg_left
        ((HermitianDilation.hermitianPart_error _ (H i) (hH i)).trans (hError i)) (hw i)

end
end SparseHamiltonian.GeneralLookupSimulation
